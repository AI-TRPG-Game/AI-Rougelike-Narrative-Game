# DeepSeek 接入 —— 复制为 .env 后填入自己的 key（.env 已被 .gitignore 排除）
#
# ⚠️ 三个值都有硬性理由，别随手改：
#   · BETA_BASE_URL 必须是 /beta —— strict 是 Beta 能力，走正式路径会不认
#   · MODEL 只能是这几个之一（Phase 0 实测）：deepseek-flash / deepseek-v4-flash /
#     deepseek-v4-pro / deepseek-chat / deepseek-reasoner
#     ❌ deepseek-v4.1-flash 不可用（那是本产品的模型名，公开 API 不认）
#   · 不设 TEMPERATURE / TOP_P —— 统一非思考模式，采样参数不予传递

DEEPSEEK_API_KEY=sk-replace-me
DEEPSEEK_BETA_BASE_URL=https://api.deepseek.com/beta
DEEPSEEK_MODEL=deepseek-flash
