LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-replace-me
DEEPSEEK_BETA_BASE_URL=https://api.deepseek.com/beta
DEEPSEEK_MODEL=deepseek-flash 
# SoCLaaS：将 LLM_PROVIDER 改为 soclaas，取消下面密钥行的注释并填入自己的 key。
# SOCLAAS_API_KEY=your-soclaas-api-key
# SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
# SOCLAAS_MODEL=x-test-1
# GLM 5.3 Flash 的试用 ID（服务公告）；试用可能移除或替换，以当前模型列表为准。
# 可选：仅当服务支持此字段时设置；默认不发送推理参数。
# SOCLAAS_REASONING_EFFORT=none

